# Copy to .env and adjust. All settings are read with the DPP_ prefix.
#
# Two lines matter: where the deliveries to process are, and where the products go. Set those
# and every command below works without further arguments.

# Where the deliveries are. A project takes its blocks from <this>/<project>, so Buduunkhad's
# 79 block directories go in <this>/buduunkhad and Sant's 9 zones in <this>/sant. Read only:
# nothing in this tree is ever written to, renamed, or modified.
DPP_INPUTS_ROOT=D:/drone_inputs

# Root for ALL generated data.
#
# It has to be outside this checkout and outside any source block directory; the pipeline
# refuses to start otherwise. A 79-block survey is about 75 GB of masters, so put it on a
# volume that can take that -- ideally not the one holding the source imagery, so a full
# rebuild cannot run the sources' disk out of space.
DPP_WORKSPACE_ROOT=D:/photogrammetry_outputs

# Directory holding versioned processing profiles.
DPP_PROFILES_DIR=./profiles

# NodeODM service, used by the process / status / fetch commands.
DPP_NODEODM_URL=http://localhost:3000

# Level for the machine-readable JSONL processing log.
DPP_LOG_LEVEL=INFO
